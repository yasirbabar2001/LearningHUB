# Copy to .env and fill in. `npm run dev` and `npm start` both read .env.

# --- Supabase (public values; also embedded in the browser bundle at build time) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=<project-ref>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=<project-ref>

# --- Server-only secrets (never prefix with VITE_) ---
# Required for admin features (user management, certificates, reports, ...).
SUPABASE_SERVICE_ROLE_KEY=
# Required for the AI coach (Lovable AI gateway).
LOVABLE_API_KEY=

# --- Self-hosting ---
# Published Lovable URL; images under /__l5e/assets-v1/ are proxied from here.
LOVABLE_ASSETS_ORIGIN=https://<your-project>.lovable.app
# HTTP server for `npm start`
PORT=3000
HOST=0.0.0.0
